{
  "rules": {
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('seen').val() < now - 43200000)",
          ".validate": "newData.hasChildren(['host', 'seen'])",
          "host": { ".validate": "newData.val() === auth.uid" },
          "seen": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "online": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          ".validate": "newData.val() === true"
        },
        "guests": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($code).child('online').val() === true)",
            "$sid": { ".validate": "newData.val() === true" }
          }
        },
        "up": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($code).child('online').val() === true)",
            "$sid": {
              "$msg": { ".validate": "newData.isString() && newData.val().length <= 4000" }
            }
          }
        },
        "down": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$sid": {
              ".write": "auth != null && auth.uid === $uid && !newData.exists()",
              "$msg": {
                ".write": "auth != null && auth.uid === $uid && !newData.exists()",
                ".validate": "newData.isString() && newData.val().length <= 200000"
              }
            }
          }
        }
      }
    }
  }
}
